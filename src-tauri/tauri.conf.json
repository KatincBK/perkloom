{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "perkloom",
  "version": "0.8.0",
  "identifier": "com.denmarin.perkloom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Perkloom",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["perkloom"],
        "name": "Perkloom Project",
        "description": "Perkloom project file",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KatincBK/perkloom/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNzlGN0M0MEQ3QTkyMkMKUldRc2tub054UGQ1djZESFY1WmwzSXQ2Q0dJMlBvcFBLUlprVmRxeElnN0lnb25odVVBdS9hTmQK"
    }
  }
}
